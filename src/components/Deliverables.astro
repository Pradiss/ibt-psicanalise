---
import {
  ArrowRight,
  ClipboardCheck,
  FileChartColumn,
  GraduationCap,
  ListChecks,
  MessageCircle,
  Presentation,
  ShieldCheck,
  Target,
} from "@lucide/astro";

const deliverables = [
  {
    title: "Pesquisa e entrevistas",
    description:
      "Coleta estruturada de informações com colaboradores, RH e lideranças.",
    icon: ClipboardCheck,
  },
  {
    title: "Relatório técnico",
    description:
      "Indicadores, análises e informações organizadas para apoiar decisões.",
    icon: FileChartColumn,
  },
  {
    title: "Classificação dos riscos",
    description:
      "Identificação dos principais fatores e pontos que exigem atenção.",
    icon: ListChecks,
  },
  {
    title: "Plano de ação",
    description:
      "Recomendações práticas, prioridades e direcionamento para a empresa.",
    icon: Target,
  },
  {
    title: "Reunião de devolutiva",
    description:
      "Apresentação dos resultados para o RH, lideranças e direção.",
    icon: Presentation,
  },
  {
    title: "Treinamentos",
    description:
      "Capacitações adaptadas à realidade das equipes e da organização.",
    icon: GraduationCap,
  },
];

const whatsappNumber = "5511999999999";

const whatsappMessage = encodeURIComponent(
  "Olá! Gostaria de saber mais sobre o Programa de Gestão de Riscos Psicossociais.",
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section
  id="entregaveis"
  class="relative overflow-hidden bg-[#fdfdfb] py-16 sm:py-20 lg:py-24"
>
  <div
    class="relative mx-auto w-[min(calc(100%-32px),1250px)] sm:w-[min(calc(100%-48px),1250px)] xl:w-[min(calc(100%-64px),1250px)]"
  >
    <div class="mx-auto max-w-[880px] text-center">
      <div
        class="inline-flex items-center gap-3 rounded-full bg-[#edf7f6] px-4 py-2.5 text-[10px] font-extrabold uppercase tracking-[0.035em] text-[#147b75] min-[390px]:text-[11px] sm:px-5 sm:py-3 sm:text-[13px]"
      >
        <ShieldCheck
          size={22}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span>Entregas completas e aplicáveis</span>
      </div>

      <h2
        class="mt-6 text-[clamp(2rem,8vw,2.9rem)] font-extrabold leading-[1.12] tracking-[-0.04em] text-[#071f31] sm:mt-7 sm:text-[clamp(2.4rem,5.8vw,3.2rem)] lg:text-[clamp(2.45rem,3.4vw,2.9rem)] xl:text-[46px]"
      >
        O que sua empresa

        <span class="text-[#36C5BA]">
          recebe
        </span>
      </h2>

      <p
        class="mx-auto mt-5 max-w-[720px] text-[16px] leading-[1.65] text-[#42545f]"
      >
        Informações organizadas, recomendações práticas e direcionamento para
        apoiar decisões e estruturar ações com mais segurança.
      </p>

      <div
        class="mx-auto mt-5 h-[3px] w-16 rounded-full bg-[#36C5BA]"
      ></div>
    </div>

    <div
      class="mt-8 overflow-hidden rounded-[24px] border border-[#e1e9e7] bg-white shadow-[0_18px_50px_rgb(7_31_49_/_5%)] sm:mt-10 lg:mt-12 lg:rounded-[28px]"
    >
      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3">
        {
          deliverables.map((item, index) => {
            const Icon = item.icon;

            return (
              <article
                class:list={[
                  "group relative p-4 sm:p-6 lg:p-7",
                  index < 4 && "border-b border-[#e6ecea] lg:border-b-0",
                  index % 2 === 0 && "border-r border-[#e6ecea]",
                  index % 3 !== 2 && "lg:border-r lg:border-[#e6ecea]",
                  index % 3 === 2 && "lg:border-r-0",
                  index % 2 === 0 && "md:border-r md:border-[#e6ecea]",
                  index === 1 && "md:border-r-0 lg:border-r",
                  index === 3 && "md:border-r-0 lg:border-r",
                ]}
              >
                <div
                  class="flex size-11 items-center justify-center rounded-2xl bg-[#36C5BA]/10 text-[#147b75] sm:size-14"
                >
                  <Icon
                    size={27}
                    strokeWidth={1.8}
                    aria-hidden="true"
                    class="size-6 sm:size-[27px]"
                  />
                </div>

                <span
                  class="absolute right-4 top-4 text-[11px] font-extrabold tracking-[0.1em] text-[#36C5BA] sm:right-6 sm:top-6 sm:text-[12px]"
                >
                  0{index + 1}
                </span>

                <h3
                  class="mt-4 text-[15px] font-extrabold leading-[1.2] tracking-[-0.02em] text-[#071f31] sm:mt-6 sm:text-[18px] lg:text-[20px]"
                >
                  {item.title}
                </h3>

                <p
                  class="mt-2 text-[12px] leading-[1.45] text-[#42545f] sm:mt-3 sm:text-[14px] sm:leading-[1.6] lg:text-[15px] lg:leading-[1.65]"
                >
                  {item.description}
                </p>
              </article>
            );
          })
        }
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-5 rounded-[24px] bg-[#f1f7f6] px-6 py-6 sm:px-8 lg:flex-row lg:items-center lg:justify-between"
    >
      <p
        class="max-w-[650px] text-[16px] font-bold leading-[1.65] text-[#263a43]"
      >
        Cada entrega é apresentada de forma clara e adaptada à realidade da
        empresa.
      </p>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex min-h-16 w-full max-w-[500px] items-center gap-3 rounded-[18px] bg-gradient-to-r from-[#147b75] to-[#36C5BA] px-5 py-3.5 text-[12px] font-extrabold uppercase tracking-[0.015em] !text-white shadow-[0_16px_34px_rgb(54_197_186_/_20%)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_44px_rgb(54_197_186_/_28%)] sm:min-h-[68px] sm:gap-4 sm:rounded-[20px] sm:px-6 sm:text-[14px] lg:w-auto lg:min-w-[390px] xl:text-[15px]"
      >
        <MessageCircle
          size={25}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span class="text-left">
          Falar com um especialista
        </span>

        <ArrowRight
          size={27}
          strokeWidth={2}
          aria-hidden="true"
          class="ml-auto shrink-0 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
