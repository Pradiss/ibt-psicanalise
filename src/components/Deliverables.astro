---
import {
  BarChart3,
  ClipboardCheck,
  FileSearch,
  GraduationCap,
  ListChecks,
  ShieldCheck,
  UsersRound,
} from "@lucide/astro";

const deliverables = [
  {
    title: "Pesquisa e entrevistas",
    description: "Levantamento estruturado com equipes, RH e lideranças.",
    icon: FileSearch,
  },
  {
    title: "Relatório técnico",
    description: "Análise clara dos principais riscos identificados.",
    icon: ClipboardCheck,
  },
  {
    title: "Classificação dos riscos",
    description: "Organização dos pontos de atenção por prioridade.",
    icon: BarChart3,
  },
  {
    title: "Plano de ação",
    description: "Recomendações práticas para a realidade da empresa.",
    icon: ListChecks,
  },
  {
    title: "Devolutiva com RH e direção",
    description: "Apresentação dos resultados e orientação estratégica.",
    icon: UsersRound,
  },
  {
    title: "Treinamentos e acompanhamento",
    description: "Capacitação e suporte para implementação das ações.",
    icon: GraduationCap,
  },
];
---

<section
  id="entregaveis"
  class="relative overflow-hidden bg-[#fdfdfb] py-16 sm:py-20 lg:py-24"
>
  <!-- Curva superior direita -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-56 -top-72 hidden size-[560px] rotate-[18deg] rounded-[46%] border border-brand-500/30 xl:block"
  ></div>

  <!-- Pontos decorativos -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-[12%] top-12 hidden grid-cols-3 gap-4 opacity-50 xl:grid"
  >
    {
      Array.from({ length: 9 }).map(() => (
        <span class="size-[8px] rounded-full bg-[#c8e2df]"></span>
      ))
    }
  </div>

  <!-- Forma inferior -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-72 -left-60 hidden size-[560px] rounded-full bg-[#e8f3f1] xl:block"
  ></div>

  <div
    class="relative mx-auto w-[min(calc(100%-32px),1250px)] sm:w-[min(calc(100%-48px),1250px)] xl:w-[min(calc(100%-64px),1250px)]"
  >
    <!-- Cabeçalho -->
    <div class="mx-auto max-w-[850px] text-center">
      <div
        class="inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-[#edf7f6] to-[#deefed] px-5 py-3 text-[11px] font-extrabold uppercase tracking-[0.045em] text-brand-800 sm:text-[13px]"
      >
        <ShieldCheck
          size={24}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span>Estrutura completa para sua empresa</span>
      </div>

      <h2
        class="mt-6 text-[clamp(2rem,7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.045em] text-ink-950 lg:text-[44px]"
      >
        O que a empresa
        <span class="text-brand-600">recebe</span>
      </h2>

      <p
        class="mx-auto mt-5 max-w-[720px] text-[15px] leading-7 text-ink-700 sm:text-[17px] lg:text-[18px]"
      >
        Uma entrega completa para transformar o diagnóstico em decisões,
        prioridades e ações práticas.
      </p>

      <div
        class="mx-auto mt-5 h-[3px] w-16 rounded-full bg-brand-600"
      ></div>
    </div>

    <!-- Cards -->
    <div
      class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3 lg:gap-5"
    >
      {
        deliverables.map((item) => {
          const Icon = item.icon;

          return (
            <article
              class="group flex min-h-[190px] items-start gap-5 rounded-[22px] border border-[#dbe6e4] bg-white p-6 shadow-[0_12px_35px_rgb(7_29_43_/_6%)] transition duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-[0_20px_50px_rgb(7_29_43_/_10%)]"
            >
              <div
                class="flex size-16 shrink-0 items-center justify-center rounded-[18px] bg-gradient-to-br from-[#eef7f5] to-[#e0efed] text-brand-700"
              >
                <Icon
                  size={31}
                  strokeWidth={1.7}
                  aria-hidden="true"
                />
              </div>

              <div>
                <h3
                  class="text-[18px] font-extrabold leading-[1.35] text-brand-800"
                >
                  {item.title}
                </h3>

                <p
                  class="mt-3 text-[14px] leading-6 text-ink-700 sm:text-[15px]"
                >
                  {item.description}
                </p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>