---
import {
  BarChart3,
  ClipboardCheck,
  FileSearch,
  GraduationCap,
  ListChecks,
  UsersRound,
} from "@lucide/astro";

const deliverables = [
  {
    title: "Pesquisa e entrevistas",
    description: "Levantamento estruturado com equipes, RH e lideranças.",
    icon: FileSearch,
  },
  {
    title: "Relatório técnico",
    description: "Documento claro com análise dos principais pontos identificados.",
    icon: ClipboardCheck,
  },
  {
    title: "Classificação dos riscos",
    description: "Organização dos riscos por nível de atenção e prioridade.",
    icon: BarChart3,
  },
  {
    title: "Plano de ação",
    description: "Recomendações práticas adaptadas à realidade da empresa.",
    icon: ListChecks,
  },
  {
    title: "Devolutiva com RH e direção",
    description: "Apresentação dos resultados e orientação para tomada de decisão.",
    icon: UsersRound,
  },
  {
    title: "Treinamentos e acompanhamento",
    description: "Capacitações e suporte para colocar as ações em prática.",
    icon: GraduationCap,
  },
];
---

<section
  id="entregaveis"
  class="relative overflow-hidden bg-[#f4f9f8] py-16 sm:py-20 lg:py-24"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-48 top-16 hidden size-[420px] rounded-full border border-brand-500/20 xl:block"
  ></div>

  <div
    class="relative mx-auto w-[min(calc(100%-32px),1250px)] sm:w-[min(calc(100%-48px),1250px)] xl:w-[min(calc(100%-64px),1250px)]"
  >
    <div class="mx-auto max-w-[780px] text-center">
      <span
        class="inline-flex rounded-full bg-white px-4 py-2 text-[11px] font-extrabold uppercase tracking-[0.08em] text-brand-700 shadow-sm sm:text-xs"
      >
        Entregáveis do programa
      </span>

      <h2
  class="mt-5 text-[clamp(2rem,7vw,3rem)] font-extrabold leading-[1.12] tracking-[-0.04em] text-ink-950 lg:text-[44px]"
>
  O que a empresa
  <span class="text-brand-600"> recebe</span>
</h2>

      <p
        class="mx-auto mt-5 max-w-[650px] text-[15px] leading-7 text-ink-700 sm:text-[17px]"
      >
        Uma estrutura completa para transformar o diagnóstico em decisões e ações concretas.
      </p>
    </div>

    <div
      class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3 lg:gap-5"
    >
      {
        deliverables.map((item) => {
          const Icon = item.icon;

          return (
            <article
              class="group rounded-[24px] border border-[#dce8e5] bg-white p-6 shadow-[0_18px_50px_rgb(7_29_43_/_5%)] transition duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-[0_24px_60px_rgb(7_29_43_/_10%)]"
            >
              <div class="flex items-start gap-4">
                <div
                  class="inline-flex size-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-50 to-brand-100 text-brand-700"
                >
                  <Icon
                    size={28}
                    strokeWidth={1.8}
                    aria-hidden="true"
                  />
                </div>

                <div>
                  <h3
                    class="text-[18px] font-extrabold leading-[1.35] text-ink-950"
                  >
                    {item.title}
                  </h3>

                  <p class="mt-2 text-sm leading-6 text-ink-700 sm:text-[15px]">
                    {item.description}
                  </p>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>