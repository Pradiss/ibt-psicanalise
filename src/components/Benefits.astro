---
import {
  BarChart3,
  HeartHandshake,
  MessageSquareMore,
  ShieldCheck,
  Sparkles,
  UsersRound,
} from "@lucide/astro";

const benefits = [
  {
    title: "Mais prevenção",
    description: "Identificação antecipada de riscos.",
    icon: ShieldCheck,
  },
  {
    title: "Lideranças preparadas",
    description: "Mais clareza para conduzir equipes.",
    icon: UsersRound,
  },
  {
    title: "Menos conflitos",
    description: "Melhoria da comunicação interna.",
    icon: MessageSquareMore,
  },
  {
    title: "Apoio à NR-1",
    description: "Estrutura para gestão dos riscos psicossociais.",
    icon: HeartHandshake,
  },
  {
    title: "Mais engajamento",
    description: "Equipes mais saudáveis e produtivas.",
    icon: Sparkles,
  },
  {
    title: "Decisões com dados",
    description: "Indicadores coletivos para o RH.",
    icon: BarChart3,
  },
];
---

<section
  id="beneficios"
  class="relative overflow-hidden bg-[#f5f9f8] py-16 sm:py-20 lg:py-24"
>
  <!-- Pontos decorativos -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-[8%] top-14 hidden grid-cols-3 gap-4 opacity-45 xl:grid"
  >
    {
      Array.from({ length: 9 }).map(() => (
        <span class="size-[8px] rounded-full bg-[#c8e2df]"></span>
      ))
    }
  </div>

  <!-- Curva -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-52 -bottom-72 hidden size-[560px] rounded-full border border-brand-500/25 xl:block"
  ></div>

  <div
    class="relative mx-auto w-[min(calc(100%-32px),1250px)] sm:w-[min(calc(100%-48px),1250px)] xl:w-[min(calc(100%-64px),1250px)]"
  >
    <!-- Cabeçalho -->
    <div class="mx-auto max-w-[850px] text-center">
      <div
        class="inline-flex items-center gap-3 rounded-full bg-white px-5 py-3 text-[11px] font-extrabold uppercase tracking-[0.045em] text-brand-800 shadow-sm sm:text-[13px]"
      >
        <ShieldCheck
          size={24}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span>Resultados para sua organização</span>
      </div>

      <h2
        class="mt-6 text-[clamp(2rem,7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.045em] text-ink-950 lg:text-[44px]"
      >
        Benefícios da gestão de 
        <span class="text-brand-600">riscos psicossociais</span>
      </h2>

      <p
        class="mx-auto mt-5 max-w-[720px] text-[15px] leading-7 text-ink-700 sm:text-[17px] lg:text-[18px]"
      >
        Mais clareza para o RH, preparo para as lideranças e melhores condições
        para o desenvolvimento das equipes.
      </p>

      <div
        class="mx-auto mt-5 h-[3px] w-16 rounded-full bg-brand-600"
      ></div>
    </div>

    <!-- Cards -->
    <div
      class="mt-8 grid grid-cols-2 gap-3 sm:mt-10 sm:gap-4 lg:mt-12 lg:grid-cols-3 lg:gap-5"
    >
      {
        benefits.map((item) => {
          const Icon = item.icon;

          return (
            <article
              class="group flex min-h-[170px] flex-col items-center justify-center gap-3 rounded-[20px] border border-[#dbe6e4] bg-white p-4 text-center shadow-[0_12px_35px_rgb(7_29_43_/_6%)] transition duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-[0_20px_50px_rgb(7_29_43_/_10%)] sm:min-h-[180px] sm:gap-4 sm:rounded-[22px] sm:p-5 md:min-h-[190px] md:flex-row md:justify-start md:gap-5 md:p-6 md:text-left"
            >
              <div
                class="flex size-[58px] shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-brand-700 to-brand-500 text-white shadow-[0_12px_28px_rgb(0_104_100_/_18%)] sm:size-16 md:size-[76px]"
              >
                <Icon
                  size={34}
                  strokeWidth={1.7}
                  aria-hidden="true"
                  class="size-7 sm:size-8 md:size-[34px]"
                />
              </div>

              <div>
                <h3
                  class="text-[15px] font-extrabold leading-[1.25] text-brand-800 sm:text-[16px] md:text-[18px] md:leading-[1.35]"
                >
                  {item.title}
                </h3>

                <p
                  class="mt-2 text-[12px] leading-[1.45] text-ink-700 sm:text-[13px] md:text-[15px] md:leading-6"
                >
                  {item.description}
                </p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
