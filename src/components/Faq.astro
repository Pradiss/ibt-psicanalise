---
import { ChevronDown } from "@lucide/astro";

const faqs = [
  {
    question: "O que são riscos psicossociais?",
    answer:
      "São fatores relacionados à organização, às condições e às relações de trabalho que podem afetar a saúde emocional e o bem-estar dos colaboradores.",
  },
  {
    question: "Como funciona a implementação?",
    answer:
      "O processo envolve coleta de informações, análise técnica, relatório, plano de ação e reunião de devolutiva.",
  },
  {
    question: "Os dados são sigilosos?",
    answer:
      "Sim. A empresa recebe indicadores coletivos, preservando a confidencialidade das informações individuais.",
  },
  {
    question: "O programa é personalizado?",
    answer:
      "Sim. A metodologia é adaptada ao porte, ao contexto e às necessidades específicas de cada organização.",
  },
  {
    question: "Os treinamentos podem ser presenciais?",
    answer:
      "Sim. Os treinamentos podem acontecer presencialmente ou online, conforme a necessidade da empresa.",
  },
];
---

<section
  id="faq"
  class="bg-[#f4f1ea] py-20 sm:py-24 lg:py-28"
>
  <div
    class="mx-auto grid w-[min(calc(100%-32px),1250px)] gap-12 sm:w-[min(calc(100%-48px),1250px)] lg:grid-cols-[0.7fr_1.3fr] lg:gap-20 xl:w-[min(calc(100%-64px),1250px)]"
  >
    <div class="lg:sticky lg:top-28 lg:self-start">
      <span
        class="text-[11px] font-extrabold uppercase tracking-[0.15em] text-[#087d78]"
      >
        Dúvidas frequentes
      </span>

      <h2
        class="mt-5 max-w-[470px] text-[clamp(2.4rem,7vw,4.5rem)] font-extrabold leading-[0.98] tracking-[-0.06em] text-[#102827]"
      >
        Informação para decidir com
        <span class="text-[#087d78]">segurança.</span>
      </h2>

      <p class="mt-7 max-w-[430px] text-[16px] leading-7 text-[#687974]">
        Reunimos as principais dúvidas sobre a gestão de riscos psicossociais
        e o apoio à NR-1.
      </p>
    </div>

    <div class="border-t border-[#102827]/15">
      {
        faqs.map((faq, index) => (
          <details class="group border-b border-[#102827]/15">
            <summary
              class="flex cursor-pointer list-none items-center gap-5 py-7 sm:py-8"
            >
              <span
                class="text-xs font-extrabold tracking-[0.08em] text-[#087d78]"
              >
                0{index + 1}
              </span>

              <span
                class="flex-1 text-[18px] font-extrabold leading-6 tracking-[-0.02em] text-[#102827] sm:text-[22px]"
              >
                {faq.question}
              </span>

              <span
                class="flex size-11 items-center justify-center rounded-full border border-[#102827]/15 transition duration-300 group-open:rotate-180 group-open:bg-[#087d78] group-open:text-white"
              >
                <ChevronDown size={20} strokeWidth={1.8} />
              </span>
            </summary>

            <div class="pb-8 pl-0 sm:pl-[52px]">
              <p class="max-w-[650px] text-[15px] leading-7 text-[#687974]">
                {faq.answer}
              </p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>