---
import {
  Menu,
  MessageCircle,
  X,
} from "@lucide/astro";

import logoImage from "../assets/images/logo-ibt.svg";

const whatsappNumber = "5511999999999";

const whatsappMessage = encodeURIComponent(
  "Olá! Gostaria de falar com um especialista sobre Gestão de Riscos Psicossociais e apoio à NR-1.",
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

const menuItems = [
  {
    label: "Como funciona",
    href: "#processo",
  },
  {
    label: "O que avaliamos",
    href: "#avaliacao",
  },
  {
    label: "Benefícios",
    href: "#beneficios",
  },
  {
    label: "Planos",
    href: "#planos",
  },
  {
    label: "Dúvidas",
    href: "#faq",
  },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-[100]  bg-[#fdfdfb]/95 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-[76px] w-[min(calc(100%-32px),1250px)] items-center justify-between sm:w-[min(calc(100%-48px),1250px)] lg:h-[82px] xl:w-[min(calc(100%-64px),1250px)]"
  >
    <!-- Logo -->
    <a
      href="#inicio"
      aria-label="Voltar ao início"
      class="relative z-20 flex shrink-0 items-center"
    >
      <img
        src={logoImage.src}
        width={logoImage.width}
        height={logoImage.height}
        alt="IBT Psicanálise"
        class="h-auto w-[132px] sm:w-[145px]"
      />
    </a>

    <!-- Menu desktop -->
    <nav
      aria-label="Navegação principal"
      class="hidden items-center gap-7 lg:flex"
    >
      {
        menuItems.map((item) => (
          <a
            href={item.href}
            class="relative py-2 text-[13px] font-bold text-[#34464e] transition hover:text-[#147b75]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- CTA desktop -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group hidden min-h-[46px] items-center gap-2.5 rounded-full bg-gradient-to-r from-[#147b75] to-[#36C5BA] px-5 text-[11px] font-extrabold uppercase tracking-[0.025em] !text-white shadow-[0_10px_24px_rgb(54_197_186_/_20%)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_14px_30px_rgb(54_197_186_/_28%)] lg:inline-flex"
    >
      <MessageCircle
        size={19}
        strokeWidth={2}
        aria-hidden="true"
      />

      <span>Falar com especialista</span>
    </a>

    <!-- Botão hambúrguer -->
    <button
      id="menu-button"
      type="button"
      aria-label="Abrir menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="relative z-20 flex size-11 items-center justify-center rounded-full border border-[#dbe6e4] bg-white text-[#147b75] shadow-[0_8px_20px_rgb(7_31_49_/_6%)] transition hover:border-[#36C5BA]/50 hover:bg-[#f1f8f7] lg:hidden"
    >
      <Menu
        id="menu-open-icon"
        size={25}
        strokeWidth={2}
        aria-hidden="true"
      />

      <X
        id="menu-close-icon"
        size={25}
        strokeWidth={2}
        aria-hidden="true"
        class="hidden"
      />
    </button>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    class="pointer-events-none invisible absolute inset-x-0 top-full translate-y-[-8px] border-b border-[#dfe9e7] bg-[#fdfdfb] opacity-0 shadow-[0_22px_50px_rgb(7_31_49_/_10%)] transition duration-200 lg:hidden"
  >
    <div
      class="mx-auto w-[min(calc(100%-32px),1250px)] py-5 sm:w-[min(calc(100%-48px),1250px)]"
    >
      <nav
        aria-label="Navegação mobile"
        class="flex flex-col"
      >
        {
          menuItems.map((item) => (
            <a
              href={item.href}
              data-mobile-link
              class="border-b border-[#e6edeb] py-4 text-[15px] font-extrabold text-[#17303a] transition hover:pl-2 hover:text-[#147b75]"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex min-h-[54px] w-full items-center justify-center gap-3 rounded-[16px] bg-gradient-to-r from-[#147b75] to-[#36C5BA] px-5 text-[12px] font-extrabold uppercase tracking-[0.02em] !text-white shadow-[0_12px_28px_rgb(54_197_186_/_22%)]"
      >
        <MessageCircle
          size={21}
          strokeWidth={2}
          aria-hidden="true"
        />

        <span>Falar com um especialista</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const menuButton = document.querySelector("#menu-button");
  const mobileMenu = document.querySelector("#mobile-menu");
  const menuOpenIcon = document.querySelector("#menu-open-icon");
  const menuCloseIcon = document.querySelector("#menu-close-icon");
  const mobileLinks = document.querySelectorAll("[data-mobile-link]");

  function openMenu() {
    if (!menuButton || !mobileMenu) return;

    menuButton.setAttribute("aria-expanded", "true");
    menuButton.setAttribute("aria-label", "Fechar menu");

    mobileMenu.classList.remove(
      "pointer-events-none",
      "invisible",
      "translate-y-[-8px]",
      "opacity-0",
    );

    mobileMenu.classList.add(
      "pointer-events-auto",
      "visible",
      "translate-y-0",
      "opacity-100",
    );

    menuOpenIcon?.classList.add("hidden");
    menuCloseIcon?.classList.remove("hidden");
  }

  function closeMenu() {
    if (!menuButton || !mobileMenu) return;

    menuButton.setAttribute("aria-expanded", "false");
    menuButton.setAttribute("aria-label", "Abrir menu");

    mobileMenu.classList.remove(
      "pointer-events-auto",
      "visible",
      "translate-y-0",
      "opacity-100",
    );

    mobileMenu.classList.add(
      "pointer-events-none",
      "invisible",
      "translate-y-[-8px]",
      "opacity-0",
    );

    menuOpenIcon?.classList.remove("hidden");
    menuCloseIcon?.classList.add("hidden");
  }

  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";

    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024) {
      closeMenu();
    }
  });
</script>