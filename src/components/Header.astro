---
import { MessageCircle } from "@lucide/astro";

import logoImage from "../assets/images/logo-ibt.svg";

const whatsappNumber = "5511999999999";

const whatsappMessage = encodeURIComponent(
  "Olá! Gostaria de falar com um especialista sobre Gestão de Riscos Psicossociais e apoio à NR-1.",
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

const menuItems = [
  {
    label: "Como funciona",
    href: "#processo",
  },
  {
    label: "O que avaliamos",
    href: "#avaliacao",
  },
  {
    label: "Benefícios",
    href: "#beneficios",
  },
  {
    label: "Contratação",
    href: "#planos",
  },
  {
    label: "Dúvidas",
    href: "#faq",
  },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-[100] border-b border-[#dfe9e7]/80 bg-[#fdfdfb]/95 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-[74px] w-[min(calc(100%-32px),1250px)] items-center justify-between sm:w-[min(calc(100%-48px),1250px)] lg:h-[82px] xl:w-[min(calc(100%-64px),1250px)]"
  >
    <!-- Logo -->
    <a
      href="#inicio"
      aria-label="Voltar ao início"
      class="relative z-20 flex shrink-0 items-center"
    >
      <img
        src={logoImage.src}
        width={logoImage.width}
        height={logoImage.height}
        alt="IBT Psicanálise"
        class="h-auto w-[130px] sm:w-[145px]"
      />
    </a>

    <!-- Menu desktop -->
    <nav
      aria-label="Navegação principal"
      class="hidden items-center gap-7 lg:flex"
    >
      {
        menuItems.map((item) => (
          <a
            href={item.href}
            class="relative py-2 text-[13px] font-bold text-[#34464e] transition duration-200 hover:text-[#147b75]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- CTA desktop -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group hidden min-h-[46px] items-center gap-2.5 rounded-full bg-gradient-to-r from-[#147b75] to-[#36C5BA] px-5 text-[11px] font-extrabold uppercase tracking-[0.025em] !text-white shadow-[0_10px_24px_rgb(54_197_186_/_20%)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_14px_30px_rgb(54_197_186_/_28%)] lg:inline-flex"
    >
      <MessageCircle
        size={19}
        strokeWidth={2}
        aria-hidden="true"
      />

      <span>Falar com especialista</span>
    </a>

    <!-- Botão hambúrguer mobile -->
    <button
      id="menu-button"
      type="button"
      aria-label="Abrir menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="relative z-20 flex size-11 shrink-0 items-center justify-center rounded-[14px] border border-[#dbe6e4] bg-white text-[#147b75] shadow-[0_8px_20px_rgb(7_31_49_/_6%)] transition duration-200 hover:border-[#36C5BA]/50 hover:bg-[#f1f8f7] active:scale-95 lg:hidden"
    >
      <span class="relative block h-[18px] w-[23px]">
        <span
          id="menu-line-1"
          class="absolute left-0 top-0 h-[2px] w-full rounded-full bg-current transition-all duration-300"
        ></span>

        <span
          id="menu-line-2"
          class="absolute left-0 top-1/2 h-[2px] w-[17px] -translate-y-1/2 rounded-full bg-current transition-all duration-300"
        ></span>

        <span
          id="menu-line-3"
          class="absolute bottom-0 left-0 h-[2px] w-full rounded-full bg-current transition-all duration-300"
        ></span>
      </span>
    </button>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    class="pointer-events-none invisible absolute inset-x-0 top-full translate-y-[-10px] border-b border-[#dfe9e7] bg-[#fdfdfb] opacity-0 shadow-[0_20px_45px_rgb(7_31_49_/_10%)] transition-all duration-300 lg:hidden"
  >
    <div
      class="mx-auto w-[min(calc(100%-32px),1250px)] py-5 sm:w-[min(calc(100%-48px),1250px)]"
    >
      <nav
        aria-label="Navegação mobile"
        class="flex flex-col"
      >
        {
          menuItems.map((item) => (
            <a
              href={item.href}
              data-mobile-link
              class="flex min-h-[54px] items-center border-b border-[#e6edeb] text-[15px] font-bold text-[#17303a] transition duration-200 hover:pl-2 hover:text-[#147b75]"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex min-h-[54px] w-full items-center justify-center gap-3 rounded-[16px] bg-gradient-to-r from-[#147b75] to-[#36C5BA] px-5 text-[12px] font-extrabold uppercase tracking-[0.02em] !text-white shadow-[0_12px_28px_rgb(54_197_186_/_22%)]"
      >
        <MessageCircle
          size={21}
          strokeWidth={2}
          aria-hidden="true"
        />

        <span>Falar com um especialista</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const menuButton = document.querySelector("#menu-button");
  const mobileMenu = document.querySelector("#mobile-menu");

  const menuLine1 = document.querySelector("#menu-line-1");
  const menuLine2 = document.querySelector("#menu-line-2");
  const menuLine3 = document.querySelector("#menu-line-3");

  const mobileLinks = document.querySelectorAll("[data-mobile-link]");

  function openMenu() {
    if (!menuButton || !mobileMenu) return;

    menuButton.setAttribute("aria-expanded", "true");
    menuButton.setAttribute("aria-label", "Fechar menu");

    mobileMenu.classList.remove(
      "pointer-events-none",
      "invisible",
      "translate-y-[-10px]",
      "opacity-0",
    );

    mobileMenu.classList.add(
      "pointer-events-auto",
      "visible",
      "translate-y-0",
      "opacity-100",
    );

    menuLine1?.classList.remove("top-0");
    menuLine1?.classList.add(
      "top-1/2",
      "-translate-y-1/2",
      "rotate-45",
    );

    menuLine2?.classList.add(
      "opacity-0",
      "scale-x-0",
    );

    menuLine3?.classList.remove("bottom-0");
    menuLine3?.classList.add(
      "bottom-1/2",
      "translate-y-1/2",
      "-rotate-45",
    );

    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    if (!menuButton || !mobileMenu) return;

    menuButton.setAttribute("aria-expanded", "false");
    menuButton.setAttribute("aria-label", "Abrir menu");

    mobileMenu.classList.remove(
      "pointer-events-auto",
      "visible",
      "translate-y-0",
      "opacity-100",
    );

    mobileMenu.classList.add(
      "pointer-events-none",
      "invisible",
      "translate-y-[-10px]",
      "opacity-0",
    );

    menuLine1?.classList.remove(
      "top-1/2",
      "-translate-y-1/2",
      "rotate-45",
    );

    menuLine1?.classList.add("top-0");

    menuLine2?.classList.remove(
      "opacity-0",
      "scale-x-0",
    );

    menuLine3?.classList.remove(
      "bottom-1/2",
      "translate-y-1/2",
      "-rotate-45",
    );

    menuLine3?.classList.add("bottom-0");

    document.body.style.overflow = "";
  }

  menuButton?.addEventListener("click", () => {
    const isOpen =
      menuButton.getAttribute("aria-expanded") === "true";

    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });

  document.addEventListener("click", (event) => {
    if (!menuButton || !mobileMenu) return;

    const target = event.target;

    if (
      target instanceof Node &&
      !menuButton.contains(target) &&
      !mobileMenu.contains(target)
    ) {
      closeMenu();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024) {
      closeMenu();
    }
  });
</script>