---
import {
  ArrowRight,
  Brain,
  ClipboardCheck,
  MessageCircleMore,
  ShieldCheck,
  Star,
  TrendingDown,
  UsersRound,
} from "@lucide/astro";

const whatsappNumber = "5511999999999";

const whatsappMessage = encodeURIComponent(
  "Olá! Gostaria de solicitar uma avaliação sobre riscos psicossociais e adequação à NR-1.",
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

const challenges = [
  {
    title: "Sobrecarga e estresse",
    icon: Brain,
  },
  {
    title: "Conflitos e falhas de comunicação",
    icon: UsersRound,
  },
  {
    title: "Afastamentos e queda de produtividade",
    icon: TrendingDown,
  },
  {
    title: "Dificuldade para estruturar ações da NR-1",
    icon: ClipboardCheck,
  },
];
---

<section
  id="desafios"
  class="relative overflow-hidden bg-[#fdfdfb] py-16 sm:py-20 lg:py-24"
>
  <!-- Curva superior direita -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-56 -top-72 hidden size-[560px] rotate-[18deg] rounded-[46%] border border-brand-500/30 xl:block"
  >
  </div>

  <!-- Pontos -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-[17%] top-8 hidden grid-cols-4 gap-[14px] opacity-50 xl:grid"
  >
    {
      Array.from({ length: 12 }).map(() => (
        <span class="size-[7px] rounded-full bg-[#c8e2df]" />
      ))
    }
  </div>

  <!-- Forma inferior esquerda -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-72 -left-56 hidden size-[560px] rounded-full bg-[#e8f3f1] xl:block"
  >
  </div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-[310px] -left-44 hidden size-[590px] rounded-full border border-brand-500/25 xl:block"
  >
  </div>

  <div
    class="relative mx-auto w-[min(calc(100%-32px),1250px)] sm:w-[min(calc(100%-48px),1250px)] xl:w-[min(calc(100%-64px),1250px)]"
  >
    <!-- Cabeçalho -->
    <div class="mx-auto max-w-[850px] text-center">
      <div
        class="inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-[#edf7f6] to-[#deefed] px-5 py-3 text-[11px] font-extrabold uppercase tracking-[0.045em] text-brand-800 sm:text-[13px]"
      >
        <ShieldCheck
          size={24}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span>Desafios reais. Impactos reais.</span>
      </div>

      <h2
        class="mt-6 text-[clamp(2rem,7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.045em] text-ink-950 lg:text-[44px]"
      >
        Sua empresa enfrenta
        <span class="block text-brand-600"> algum destes desafios? </span>
      </h2>
    </div>

    <!-- Cards -->
    <div
      class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4 lg:gap-4 xl:gap-5"
    >
      {
        challenges.map((challenge) => {
          const Icon = challenge.icon;

          return (
            <article class="flex min-h-[280px] flex-col items-center justify-center rounded-[22px] border border-[#dbe6e4] bg-white px-5 py-8 text-center shadow-[0_12px_35px_rgb(7_29_43_/_7%)] transition duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-[0_20px_50px_rgb(7_29_43_/_11%)] lg:min-h-[300px]">
              <div class="flex size-[112px] items-center justify-center rounded-full bg-gradient-to-br from-[#eef7f5] to-[#e0efed] text-brand-700 lg:size-[120px]">
                <Icon size={55} strokeWidth={1.65} aria-hidden="true" />
              </div>

              <h3 class="mt-6 max-w-[250px] text-[18px] font-extrabold leading-[1.35] text-ink-950 lg:text-[19px]">
                {challenge.title}
              </h3>

              <div class="mt-5 h-[3px] w-11 rounded-full bg-brand-600" />
            </article>
          );
        })
      }
    </div>

    <!-- Destaque -->
    <div
      class="mx-auto mt-8 flex max-w-[980px] flex-col items-center gap-5 rounded-[24px] bg-gradient-to-r from-[#edf5f4] to-[#e8f1ef] px-6 py-6 sm:flex-row sm:px-8 lg:px-10"
    >
      <div
        class="flex size-16 shrink-0 items-center justify-center rounded-full border-2 border-brand-600 text-brand-700"
      >
        <Star size={31} strokeWidth={1.8} aria-hidden="true" />
      </div>

      <div class="hidden h-16 w-px shrink-0 bg-brand-500/45 sm:block"></div>

      <p
        class="text-center text-[16px] leading-7 text-ink-950 sm:text-left sm:text-[18px] lg:text-[19px]"
      >
        Nosso programa transforma esses sinais em
        <strong class="font-extrabold text-brand-700">
          diagnóstico, prioridades e ações práticas.
        </strong>
      </p>
    </div>

    <!-- CTA -->
    <div class="mt-6 flex justify-center">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex min-h-16 w-full max-w-[500px] items-center gap-3 rounded-[18px] bg-gradient-to-r from-[#006b67] to-[#078b86] px-5 py-3.5 text-[12px] font-extrabold uppercase tracking-[0.015em] !text-white shadow-[0_16px_34px_rgb(0_95_92_/_22%)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_44px_rgb(0_95_92_/_28%)] sm:min-h-[68px] sm:gap-4 sm:rounded-[20px] sm:px-6 sm:text-[14px] xl:text-[15px]"
      >
        <MessageCircleMore
          size={25}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span class="text-left"> Solicitar uma avaliação </span>

        <ArrowRight
          size={27}
          strokeWidth={2}
          aria-hidden="true"
          class="ml-auto shrink-0 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
