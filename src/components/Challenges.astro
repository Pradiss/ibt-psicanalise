---
import {
  ArrowRight,
  Brain,
  ClipboardCheck,
  MessageCircle,
  MessagesSquare,
  ShieldCheck,
  Sparkles,
  TrendingDown,
} from "@lucide/astro";

const challenges = [
  {
    title: "Sobrecarga e estresse",
    icon: Brain,
  },
  {
    title: "Conflitos e falhas de comunicação",
    icon: MessagesSquare,
  },
  {
    title: "Afastamentos e queda de produtividade",
    icon: TrendingDown,
  },
  {
    title: "Dificuldade para estruturar ações da NR-1",
    icon: ClipboardCheck,
  },
];

const whatsappNumber = "5511999999999";

const whatsappMessage = encodeURIComponent(
  "Olá! Gostaria de solicitar uma avaliação sobre Gestão de Riscos Psicossociais e apoio à NR-1.",
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section
  id="desafios"
  class="relative overflow-hidden bg-[#fdfdfb] py-16 sm:py-20 lg:py-24"
>
  <!-- Forma orgânica inferior -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-44 -left-36 hidden size-[420px] rounded-[46%_54%_48%_52%] bg-[#36C5BA]/[0.07] lg:block"
  ></div>

  <!-- Linha orgânica direita -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-44 -top-52 hidden size-[500px] rounded-full border border-[#36C5BA]/25 xl:block"
  ></div>

  <!-- Pontos decorativos -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-[7%] top-16 hidden grid-cols-4 gap-4 lg:grid"
  >
    {
      Array.from({ length: 12 }).map(() => (
        <span class="size-[7px] rounded-full bg-[#36C5BA]/20"></span>
      ))
    }
  </div>

  <div
    class="relative mx-auto w-[min(calc(100%-32px),1250px)] sm:w-[min(calc(100%-48px),1250px)] xl:w-[min(calc(100%-64px),1250px)]"
  >
    <!-- Cabeçalho -->
    <div class="mx-auto max-w-[880px] text-center">
      <div
        class="inline-flex max-w-full items-center gap-2.5 rounded-full bg-gradient-to-r from-[#edf7f6] to-[#deefed] px-4 py-2.5 text-[10px] font-extrabold uppercase tracking-[0.035em] text-[#147b75] min-[390px]:text-[11px] sm:gap-3 sm:px-5 sm:py-3 sm:text-[13px]"
      >
        <ShieldCheck
          size={22}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span>Desafios reais. Impactos reais.</span>
      </div>

      <h2
        class="mt-6 text-[clamp(2rem,8vw,2.9rem)] font-extrabold leading-[1.12] tracking-[-0.04em] text-[#071f31] sm:mt-7 sm:text-[clamp(2.4rem,5.8vw,3.2rem)] lg:text-[clamp(2.45rem,3.4vw,2.9rem)] xl:text-[46px]"
      >
        Sua empresa enfrenta

        <span class="block text-[#36C5BA]">
          algum destes desafios?
        </span>
      </h2>

      <p
        class="mx-auto mt-5 max-w-[720px] text-[16px] leading-[1.65] text-[#42545f]"
      >
        Identificar esses sinais é o primeiro passo para proteger as equipes,
        melhorar o ambiente de trabalho e estruturar ações mais assertivas.
      </p>

      <div
        class="mx-auto mt-5 h-[3px] w-14 rounded-full bg-[#36C5BA]"
      ></div>
    </div>

    <!-- Desafios -->
    <div
      class="mt-8 grid grid-cols-2 gap-3 sm:mt-10 sm:gap-4 lg:mt-12 xl:grid-cols-4"
    >
      {
        challenges.map((item, index) => {
          const Icon = item.icon;

          return (
            <article
              class="group relative flex min-h-[178px] flex-col items-center overflow-hidden rounded-[20px] border border-[#dfe9e7] bg-white px-3 py-5 text-center shadow-[0_14px_38px_rgb(7_31_49_/_5%)] transition duration-300 hover:-translate-y-1.5 hover:border-[#36C5BA]/45 hover:shadow-[0_22px_52px_rgb(7_31_49_/_9%)] sm:min-h-[230px] sm:rounded-[24px] sm:px-5 sm:py-6 md:min-h-[295px] md:rounded-[28px] md:px-6 md:py-7 lg:min-h-[315px]"
            >
              <span
                class="absolute right-3 top-3 text-[24px] font-extrabold leading-none tracking-[-0.06em] text-[#071f31]/[0.055] sm:right-5 sm:top-4 sm:text-[30px] md:text-[34px]"
              >
                0{index + 1}
              </span>

              <div
                class="flex size-[64px] items-center justify-center rounded-full bg-gradient-to-br from-[#eef8f7] to-[#dcefeb] text-[#147b75] transition duration-300 group-hover:scale-105 sm:size-[84px] md:size-[112px]"
              >
                <Icon
                  size={50}
                  strokeWidth={1.65}
                  aria-hidden="true"
                  class="size-8 sm:size-10 md:size-[50px]"
                />
              </div>

              <h3
                class="mx-auto mt-4 max-w-[135px] text-[14px] font-extrabold leading-[1.25] tracking-[-0.025em] text-[#071f31] sm:mt-5 sm:max-w-[210px] sm:text-[18px] md:mt-7 md:max-w-[235px] md:text-[20px] lg:text-[21px]"
              >
                {item.title}
              </h3>

              <div class="mt-auto pt-6">
                <div
                  class="mx-auto h-[3px] w-10 rounded-full bg-[#147b75] transition-all duration-300 group-hover:w-16 group-hover:bg-[#36C5BA] sm:w-12 sm:group-hover:w-20"
                ></div>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Destaque -->
    <div
      class="mx-auto mt-8 max-w-[940px] overflow-hidden rounded-[26px] border border-[#36C5BA]/10 bg-gradient-to-r from-[#eef7f6] to-[#f5faf9] px-5 py-5 sm:px-7 sm:py-6"
    >
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
        <div
          class="flex size-[70px] shrink-0 items-center justify-center rounded-full border border-[#147b75]/20 bg-white text-[#147b75] shadow-[0_10px_28px_rgb(7_31_49_/_6%)]"
        >
          <Sparkles
            size={31}
            strokeWidth={1.7}
            aria-hidden="true"
          />
        </div>

        <div
          class="hidden h-14 w-px shrink-0 bg-[#147b75]/20 sm:block"
        ></div>

        <p class="text-[16px] leading-[1.65] text-[#263a43]">
          Nosso programa transforma esses sinais em

          <strong class="font-extrabold text-[#147b75]">
            diagnóstico, prioridades e ações práticas.
          </strong>
        </p>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-7 flex justify-center">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Solicitar uma avaliação pelo WhatsApp"
        class="group inline-flex min-h-16 w-full max-w-[500px] items-center gap-3 rounded-[18px] bg-gradient-to-r from-[#147b75] to-[#36C5BA] px-5 py-3.5 text-[12px] font-extrabold uppercase tracking-[0.015em] !text-white shadow-[0_16px_34px_rgb(54_197_186_/_22%)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_44px_rgb(54_197_186_/_30%)] sm:min-h-[68px] sm:gap-4 sm:rounded-[20px] sm:px-6 sm:text-[14px] xl:text-[15px]"
      >
        <span
          class="flex size-11 shrink-0 items-center justify-center rounded-full border border-white/25 bg-white/10"
        >
          <MessageCircle
            size={24}
            strokeWidth={2}
            aria-hidden="true"
          />
        </span>

        <span class="text-left">
          Solicitar uma avaliação
        </span>

        <ArrowRight
          size={27}
          strokeWidth={2}
          aria-hidden="true"
          class="ml-auto shrink-0 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
