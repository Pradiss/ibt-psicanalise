---
import {
  ArrowRight,
  BrainCircuit,
  ChartNoAxesColumnDecreasing,
  ClipboardCheck,
  MessageCircle,
  MessagesSquare,
  ShieldCheck,
  Sparkles,
} from "@lucide/astro";

const challenges = [
  {
    title: "Sobrecarga e estresse",
    description:
      "Demandas excessivas, pressão constante e dificuldade para manter o equilíbrio emocional.",
    icon: BrainCircuit,
  },
  {
    title: "Conflitos e comunicação",
    description:
      "Falhas na comunicação que fragilizam as relações, a confiança e a colaboração.",
    icon: MessagesSquare,
  },
  {
    title: "Afastamentos e produtividade",
    description:
      "Impactos emocionais que aumentam ausências e comprometem o desempenho das equipes.",
    icon: ChartNoAxesColumnDecreasing,
  },
  {
    title: "Ações relacionadas à NR-1",
    description:
      "Dificuldade para identificar riscos, estabelecer prioridades e estruturar ações.",
    icon: ClipboardCheck,
  },
];

const whatsappNumber = "5511999999999";

const whatsappMessage = encodeURIComponent(
  "Olá! Gostaria de solicitar uma avaliação sobre Gestão de Riscos Psicossociais e apoio à NR-1.",
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section
  id="desafios"
  class="relative overflow-hidden bg-[#fdfdfb] py-16 sm:py-20 lg:py-24"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-[7%] top-16 hidden grid-cols-4 gap-4 lg:grid"
  >
    {
      Array.from({ length: 12 }).map(() => (
        <span class="size-2 rounded-full bg-[#36C5BA]/20"></span>
      ))
    }
  </div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-52 -top-64 hidden size-[540px] rounded-full border border-[#36C5BA]/20 xl:block"
  ></div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-52 -left-44 hidden size-[440px] rounded-full bg-[#36C5BA]/[0.06] xl:block"
  ></div>

  <div
    class="relative mx-auto w-[min(calc(100%-32px),1250px)] sm:w-[min(calc(100%-48px),1250px)] xl:w-[min(calc(100%-64px),1250px)]"
  >
    <div class="mx-auto max-w-[860px] text-center">
      <div
        class="inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-[#edf7f6] to-[#deefed] px-4 py-2.5 text-[10px] font-extrabold uppercase tracking-[0.035em] text-[#147b75] min-[390px]:text-[11px] sm:px-5 sm:py-3 sm:text-[13px]"
      >
        <ShieldCheck
          size={22}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span>Desafios reais. Impactos reais.</span>
      </div>

      <h2
        class="mt-6 text-[clamp(2rem,8vw,2.9rem)] font-extrabold leading-[1.12] tracking-[-0.04em] text-[#071f31] sm:mt-7 sm:text-[clamp(2.4rem,5.8vw,3.2rem)] lg:text-[clamp(2.45rem,3.4vw,2.9rem)] xl:text-[46px]"
      >
        Sua empresa enfrenta

        <span class="block text-[#36C5BA]">
          algum destes desafios?
        </span>
      </h2>

      <div
        class="mx-auto mt-5 h-[3px] w-14 rounded-full bg-[#36C5BA]"
      ></div>

      <p
        class="mx-auto mt-5 max-w-[720px] text-[16px] leading-[1.65] text-[#42545f]"
      >
        Alguns sinais aparecem silenciosamente no cotidiano, mas afetam
        diretamente a saúde das equipes, o clima organizacional e os
        resultados da empresa.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {
        challenges.map((item, index) => {
          const Icon = item.icon;

          return (
            <article
              class="group relative flex min-h-[350px] flex-col overflow-hidden rounded-[28px] border border-[#dfe9e7] bg-white p-7 shadow-[0_16px_45px_rgb(7_31_49_/_6%)] transition duration-300 hover:-translate-y-2 hover:border-[#36C5BA]/45 hover:shadow-[0_24px_60px_rgb(7_31_49_/_10%)]"
            >
              <span
                class="absolute right-6 top-5 text-[42px] font-extrabold leading-none tracking-[-0.07em] text-[#071f31]/[0.055]"
              >
                0{index + 1}
              </span>

              <div
                class="flex size-[102px] items-center justify-center rounded-[30px] bg-gradient-to-br from-[#36C5BA]/15 to-[#36C5BA]/5 text-[#147b75] transition duration-300 group-hover:scale-105"
              >
                <Icon
                  size={46}
                  strokeWidth={1.6}
                  aria-hidden="true"
                />
              </div>

              <div class="mt-auto pt-9">
                <h3
                  class="text-[21px] font-extrabold leading-[1.2] tracking-[-0.035em] text-[#071f31]"
                >
                  {item.title}
                </h3>

                <p class="mt-3 text-[15px] leading-[1.65] text-[#42545f]">
                  {item.description}
                </p>
              </div>

              <div
                class="absolute bottom-0 left-0 h-1 w-0 bg-gradient-to-r from-[#147b75] to-[#36C5BA] transition-all duration-500 group-hover:w-full"
              ></div>
            </article>
          );
        })
      }
    </div>

    <div
      class="mx-auto mt-9 max-w-[930px] rounded-[24px] border border-[#36C5BA]/15 bg-[#f1f8f7] px-6 py-6 sm:px-8"
    >
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
        <div
          class="flex size-[70px] shrink-0 items-center justify-center rounded-full bg-white text-[#147b75] shadow-[0_10px_30px_rgb(7_31_49_/_7%)]"
        >
          <Sparkles
            size={31}
            strokeWidth={1.7}
            aria-hidden="true"
          />
        </div>

        <div class="hidden h-14 w-px bg-[#147b75]/20 sm:block"></div>

        <p class="text-[16px] leading-[1.65] text-[#263a43]">
          Nosso programa transforma esses sinais em

          <strong class="font-extrabold text-[#147b75]">
            diagnóstico, prioridades e ações práticas.
          </strong>
        </p>
      </div>
    </div>

    <div class="mt-8 flex justify-center">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Solicitar uma avaliação pelo WhatsApp"
        class="group inline-flex min-h-16 w-full max-w-[500px] items-center gap-3 rounded-[18px] bg-gradient-to-r from-[#147b75] to-[#36C5BA] px-5 py-3.5 text-[12px] font-extrabold uppercase tracking-[0.015em] text-white shadow-[0_16px_34px_rgb(54_197_186_/_22%)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_44px_rgb(54_197_186_/_30%)] sm:min-h-[68px] sm:gap-4 sm:rounded-[20px] sm:px-6 sm:text-[14px] xl:text-[15px]"
      >
        <MessageCircle
          size={25}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span class="text-left">Solicitar uma avaliação</span>

        <ArrowRight
          size={27}
          strokeWidth={2}
          aria-hidden="true"
          class="ml-auto shrink-0 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>