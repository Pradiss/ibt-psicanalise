---
import {
  ArrowRight,
  BarChart3,
  ClipboardCheck,
  FileSearch,
  MessageCircle,
  Settings2,
  ShieldCheck,
} from "@lucide/astro";

const steps = [
  {
    number: "01",
    title: "Diagnóstico",
    description:
      "Aplicamos pesquisas e realizamos entrevistas para compreender a realidade da empresa e das equipes.",
    icon: FileSearch,
  },
  {
    number: "02",
    title: "Análise técnica",
    description:
      "Organizamos as informações, identificamos os riscos e definimos os pontos que exigem maior atenção.",
    icon: ClipboardCheck,
  },
  {
    number: "03",
    title: "Plano de ação",
    description:
      "Transformamos o diagnóstico em orientações, prioridades e ações práticas para a organização.",
    icon: Settings2,
  },
  {
    number: "04",
    title: "Acompanhamento",
    description:
      "Apoiamos o RH e as lideranças no acompanhamento das ações e na análise dos indicadores.",
    icon: BarChart3,
  },
];

const whatsappNumber = "5511999999999";

const whatsappMessage = encodeURIComponent(
  "Olá! Gostaria de entender como funciona o Programa de Gestão de Riscos Psicossociais.",
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section
  id="processo"
  class="relative overflow-hidden bg-[#073f3d] py-16 text-white sm:py-20 lg:py-24"
>
  <!-- Círculo decorativo superior -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-56 -top-64 hidden size-[560px] rounded-full border border-white/10 xl:block"
  ></div>

  <!-- Forma decorativa inferior -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-60 -left-48 hidden size-[500px] rounded-full bg-[#36C5BA]/[0.07] lg:block"
  ></div>

  <!-- Pontos decorativos -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-[8%] top-16 hidden grid-cols-4 gap-4 lg:grid"
  >
    {
      Array.from({ length: 12 }).map(() => (
        <span class="size-[7px] rounded-full bg-[#36C5BA]/25"></span>
      ))
    }
  </div>

  <div
    class="relative mx-auto w-[min(calc(100%-32px),1250px)] sm:w-[min(calc(100%-48px),1250px)] xl:w-[min(calc(100%-64px),1250px)]"
  >
    <!-- Cabeçalho -->
    <div class="mx-auto max-w-[880px] text-center">
      <div
        class="inline-flex max-w-full items-center gap-3 rounded-full border border-white/10 bg-white/[0.07] px-4 py-2.5 text-[10px] font-extrabold uppercase tracking-[0.035em] text-[#8ce3dc] min-[390px]:text-[11px] sm:px-5 sm:py-3 sm:text-[13px]"
      >
        <ShieldCheck
          size={22}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span>Processo estruturado e personalizado</span>
      </div>

      <h2
        class="mt-6 text-[clamp(2rem,8vw,2.9rem)] font-extrabold leading-[1.12] tracking-[-0.04em] text-white sm:mt-7 sm:text-[clamp(2.4rem,5.8vw,3.2rem)] lg:text-[clamp(2.45rem,3.4vw,2.9rem)] xl:text-[46px]"
      >
        Como funciona o

        <span class="text-[#36C5BA]">
          nosso processo
        </span>
      </h2>

      <p
        class="mx-auto mt-5 max-w-[720px] text-[16px] leading-[1.65] text-white/70"
      >
        Cada etapa é conduzida de forma estratégica para transformar
        informações em decisões, prioridades e ações aplicáveis à realidade da
        empresa.
      </p>

      <div
        class="mx-auto mt-5 h-[3px] w-16 rounded-full bg-[#36C5BA]"
      ></div>
    </div>

    <!-- Processo -->
    <ol class="relative mt-8 sm:mt-10 lg:mt-14">
      <!-- Linha vertical mobile -->
      <div
        aria-hidden="true"
        class="absolute bottom-12 left-[27px] top-12 w-px bg-gradient-to-b from-[#36C5BA]/10 via-[#36C5BA]/45 to-[#36C5BA]/10 lg:hidden"
      ></div>

      <!-- Linha horizontal desktop -->
      <div
        aria-hidden="true"
        class="absolute left-[12.5%] right-[12.5%] top-[55px] hidden h-px bg-gradient-to-r from-transparent via-[#36C5BA]/50 to-transparent lg:block"
      ></div>

      <div class="grid gap-4 lg:grid-cols-4 lg:gap-0">
        {
          steps.map((step, index) => {
            const Icon = step.icon;

            return (
              <li
                class:list={[
                  "group relative pl-[62px] lg:pl-0",
                  index > 0 && "lg:border-l lg:border-white/10",
                ]}
              >
                <!-- Marcador mobile -->
                <div
                  class="absolute left-0 top-1.5 flex size-12 items-center justify-center rounded-full border border-[#36C5BA]/30 bg-[#0b5551] text-[#8ce3dc] shadow-[0_12px_28px_rgb(0_0_0_/_14%)] sm:size-14 lg:hidden"
                >
                  <Icon
                    size={25}
                    strokeWidth={1.8}
                    aria-hidden="true"
                    class="size-6 sm:size-[25px]"
                  />
                </div>

                <article
                  class="relative h-full border-b border-white/10 pb-6 lg:border-b-0 lg:px-7 lg:pb-0"
                >
                  <!-- Ícone desktop -->
                  <div
                    class="relative z-10 hidden size-[110px] items-center justify-center rounded-full border border-white/15 bg-[#0b5551] text-[#8ce3dc] shadow-[0_18px_38px_rgb(0_0_0_/_16%)] transition duration-300 group-hover:scale-105 group-hover:border-[#36C5BA]/50 group-hover:bg-[#0d605b] lg:flex"
                  >
                    <Icon
                      size={38}
                      strokeWidth={1.7}
                      aria-hidden="true"
                    />
                  </div>

                  <div class="lg:mt-8">
                    <div class="flex items-center gap-3">
                      <span
                        class="text-[11px] font-extrabold uppercase tracking-[0.12em] text-[#36C5BA]"
                      >
                        Etapa {step.number}
                      </span>

                      <span
                        class="hidden h-px flex-1 bg-white/10 lg:block"
                      ></span>
                    </div>

                    <h3
                      class="mt-2.5 text-[19px] font-extrabold leading-[1.2] tracking-[-0.03em] text-white sm:text-[22px]"
                    >
                      {step.title}
                    </h3>

                    <p
                      class="mt-3 text-[14px] leading-[1.55] text-white/60 sm:mt-4 sm:text-[15px] sm:leading-[1.65]"
                    >
                      {step.description}
                    </p>
                  </div>

                  <span
                    class="absolute right-0 top-[-8px] text-[54px] font-extrabold leading-none tracking-[-0.07em] text-white/[0.04] lg:right-6 lg:top-2"
                  >
                    {step.number}
                  </span>
                </article>
              </li>
            );
          })
        }
      </div>
    </ol>

    <!-- Bloco final -->
    <div
      class="mt-10 flex flex-col gap-6 rounded-[26px] border border-white/10 bg-white/[0.06] px-6 py-6 backdrop-blur-sm sm:px-8 lg:mt-14 lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="max-w-[650px]">
        <span
          class="text-[11px] font-extrabold uppercase tracking-[0.12em] text-[#8ce3dc]"
        >
          Atendimento personalizado
        </span>

        <p
          class="mt-3 text-[16px] font-bold leading-[1.65] text-white/90"
        >
          O processo é adaptado ao porte, ao contexto e às necessidades de cada
          organização.
        </p>
      </div>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Falar com um especialista pelo WhatsApp"
        class="group inline-flex min-h-16 w-full max-w-[500px] items-center gap-3 rounded-[18px] bg-gradient-to-r from-[#147b75] to-[#36C5BA] px-5 py-3.5 text-[12px] font-extrabold uppercase tracking-[0.015em] !text-white shadow-[0_16px_34px_rgb(0_0_0_/_18%)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_44px_rgb(0_0_0_/_26%)] sm:min-h-[68px] sm:gap-4 sm:rounded-[20px] sm:px-6 sm:text-[14px] lg:w-auto lg:min-w-[390px] xl:text-[15px]"
      >
        <MessageCircle
          size={25}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span class="text-left">
          Falar com um especialista
        </span>

        <ArrowRight
          size={27}
          strokeWidth={2}
          aria-hidden="true"
          class="ml-auto shrink-0 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
