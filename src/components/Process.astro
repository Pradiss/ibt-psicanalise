---
import {
  ArrowRight,
  BarChart3,
  ClipboardList,
  FileSearch,
  MessageCircle,
  Settings2,
} from "@lucide/astro";

const whatsappNumber = "5511999999999";

const whatsappMessage = encodeURIComponent(
  "Olá! Gostaria de entender como funciona o Programa de Gestão de Riscos Psicossociais.",
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

const steps = [
  {
    number: "01",
    title: "Diagnóstico",
    description: "Pesquisa e entrevistas.",
    detail:
      "Levantamos informações com equipes, RH e lideranças para compreender a realidade da organização.",
    icon: FileSearch,
  },
  {
    number: "02",
    title: "Relatório",
    description: "Riscos e prioridades.",
    detail:
      "Organizamos os principais fatores identificados e definimos os pontos que precisam de atenção.",
    icon: ClipboardList,
  },
  {
    number: "03",
    title: "Implementação",
    description: "Plano de ação e treinamentos.",
    detail:
      "Transformamos o diagnóstico em orientações, ações práticas e capacitações personalizadas.",
    icon: Settings2,
  },
  {
    number: "04",
    title: "Acompanhamento",
    description: "Indicadores e orientação.",
    detail:
      "Acompanhamos a evolução das ações e apoiamos o RH na análise dos indicadores coletivos.",
    icon: BarChart3,
  },
];
---

<section
  id="como-funciona"
  class="relative overflow-hidden bg-[#073638] py-16 text-white sm:py-20 lg:py-24"
>
  <!-- Elementos decorativos -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-52 -top-64 size-[520px] rounded-full border border-white/10"
  ></div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-72 -left-56 size-[560px] rounded-full bg-white/[0.035]"
  ></div>

  <div
    class="relative mx-auto w-[min(calc(100%-32px),1250px)] sm:w-[min(calc(100%-48px),1250px)] xl:w-[min(calc(100%-64px),1250px)]"
  >
    <!-- Cabeçalho assimétrico -->
    <div class="grid gap-7 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
      <div>
        <span
          class="text-[11px] font-extrabold uppercase tracking-[0.12em] text-[#80d8d2] sm:text-xs"
        >
          Etapas do programa
        </span>

        <h2
          class="mt-4 max-w-[520px] text-[clamp(2rem,7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.045em] text-white lg:text-[44px]"
        >
          Da avaliação à
          <span class="text-[#71d5cf]">ação prática</span>
        </h2>
      </div>

      <div class="lg:border-l lg:border-white/15 lg:pl-10">
        <p
          class="max-w-[620px] text-[15px] leading-7 text-white/70 sm:text-[17px]"
        >
          Um processo estruturado para identificar riscos psicossociais,
          definir prioridades e apoiar a empresa em cada etapa da
          implementação.
        </p>
      </div>
    </div>

    <!-- Linha do tempo -->
    <ol
      class="relative mt-12 grid gap-5 lg:mt-16 lg:grid-cols-4 lg:gap-0"
      aria-label="Etapas do programa"
    >
      <!-- Linha horizontal desktop -->
      <div
        aria-hidden="true"
        class="absolute left-[12.5%] right-[12.5%] top-11 hidden h-px bg-gradient-to-r from-transparent via-[#71d5cf]/60 to-transparent lg:block"
      ></div>

      {
        steps.map((step, index) => {
          const Icon = step.icon;

          return (
            <li
              class:list={[
                "relative",
                index > 0 && "lg:border-l lg:border-white/10",
              ]}
            >
              <article
                class="group relative h-full rounded-[24px] border border-white/10 bg-white/[0.055] p-6 backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:border-[#71d5cf]/45 hover:bg-white/[0.085] lg:rounded-none lg:border-y-0 lg:border-r-0 lg:bg-transparent lg:px-7 lg:py-0 lg:backdrop-blur-none lg:hover:bg-transparent"
              >
                <div class="flex items-center justify-between gap-4">
                  <div
                    class="relative z-10 flex size-[88px] items-center justify-center rounded-[26px] border border-white/15 bg-[#0b4a4b] text-[#8ee2dc] shadow-[0_18px_35px_rgb(0_0_0_/_16%)] transition duration-300 group-hover:scale-105 group-hover:bg-[#0d5656]"
                  >
                    <Icon
                      size={34}
                      strokeWidth={1.7}
                      aria-hidden="true"
                    />
                  </div>

                  <span
                    class="text-[42px] font-extrabold tracking-[-0.07em] text-white/10"
                  >
                    {step.number}
                  </span>
                </div>

                <div class="mt-7">
                  <span
                    class="text-[11px] font-bold uppercase tracking-[0.1em] text-[#71d5cf]"
                  >
                    Etapa {step.number}
                  </span>

                  <h3 class="mt-2 text-[22px] font-extrabold text-white">
                    {step.title}
                  </h3>

                  <p class="mt-2 text-[15px] font-bold text-white/85">
                    {step.description}
                  </p>

                  <p class="mt-4 text-sm leading-6 text-white/60">
                    {step.detail}
                  </p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>

    <!-- Rodapé do bloco -->
    <div
      class="mt-12 flex flex-col gap-6 rounded-[26px] border border-white/10 bg-white/[0.055] px-6 py-6 sm:px-8 lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="max-w-[670px]">
        <span
          class="text-[11px] font-extrabold uppercase tracking-[0.1em] text-[#71d5cf]"
        >
          Acompanhamento especializado
        </span>

        <p class="mt-2 text-[17px] font-bold leading-7 text-white sm:text-[19px]">
          Cada etapa é adaptada ao porte, ao contexto e às necessidades da
          sua empresa.
        </p>
      </div>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex min-h-16 w-full max-w-[500px] items-center gap-3 rounded-[18px] bg-gradient-to-r from-[#006b67] to-[#078b86] px-5 py-3.5 text-[12px] font-extrabold uppercase tracking-[0.015em] text-white shadow-[0_16px_34px_rgb(0_0_0_/_20%)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_44px_rgb(0_0_0_/_28%)] sm:min-h-[68px] sm:gap-4 sm:rounded-[20px] sm:px-6 sm:text-[14px] lg:w-auto lg:min-w-[390px] xl:text-[15px]"
      >
        <MessageCircle
          size={25}
          strokeWidth={2}
          aria-hidden="true"
          class="shrink-0"
        />

        <span>Falar com um especialista</span>

        <ArrowRight
          size={27}
          strokeWidth={2}
          aria-hidden="true"
          class="ml-auto shrink-0 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>